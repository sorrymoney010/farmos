# FARMOS Environment Configuration
# Copy to .env and modify for your environment

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1

# Database
DATABASE_URL=postgresql+asyncpg://farmos:farmos@postgres:5432/farmos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
DEVICE_ENROLLMENT_TOKEN_EXPIRE_MINUTES=15
NODE_REQUEST_MAX_SKEW_SECONDS=300
NODE_TOKEN_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:3002","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Acurast Processor management endpoint
# The official Acurast Processor app controls the wallet, attestation, jobs, and rewards.
# FARMOS only verifies and records signed processor check-ins.
ACURAST_CHECKIN_REFRESH_SECONDS=1800

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# Admin Seeding
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=FARMOS Admin

# Feature Flags
SIMULATOR_ENABLED=true

# Wireless claim / pairing codes (short codes for no-USB onboarding)
# STAGING_CLAIM_CODES=true enables fixed claim code "123" (staging/dev ONLY).
# Never enable STAGING_CLAIM_CODES in production.
STAGING_CLAIM_CODES=false
CLAIM_CODE_LENGTH=6
CLAIM_CODE_EXPIRE_MINUTES=15
STAGING_ENROLL_ADMIN_SECRET=change-me-staging-enroll-admin
STAGING_ADMIN_USER_ID=
PUBLIC_API_BASE_URL=