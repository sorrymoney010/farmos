# FARMOS Environment Configuration
# Copy to .env and modify for your environment

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1

# Database
DATABASE_URL=postgresql+asyncpg://farmos:farmos@postgres:5432/farmos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
DEVICE_ENROLLMENT_TOKEN_EXPIRE_MINUTES=15
NODE_REQUEST_MAX_SKEW_SECONDS=300
NODE_TOKEN_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:3002","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Acurast Processor management endpoint
# The official Acurast Processor app controls the wallet, attestation, jobs, and rewards.
# FARMOS only verifies and records signed processor check-ins.
ACURAST_CHECKIN_REFRESH_SECONDS=1800

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# Admin Seeding
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=FARMOS Admin

# Feature Flags
SIMULATOR_ENABLED=true

# Wireless claim / pairing codes (short codes for no-USB onboarding)
# STAGING_CLAIM_CODES=true enables fixed claim code "123" (staging/dev ONLY).
# Never enable STAGING_CLAIM_CODES in production.
STAGING_CLAIM_CODES=false
CLAIM_CODE_LENGTH=6
CLAIM_CODE_EXPIRE_MINUTES=15
STAGING_ENROLL_ADMIN_SECRET=change-me-staging-enroll-admin
STAGING_ADMIN_USER_ID=
PUBLIC_API_BASE_URL=
# Sprint 3: benchmarks / FarmScore / hardware safety (spec §9, §10)
BENCHMARK_SUITE_VERSION=farmos-bench-1
BENCHMARK_REQUIRED_FOR_ACTIVE=true
BENCHMARK_MIN_FARM_SCORE=10
THERMAL_GREEN_MAX_C=38
THERMAL_YELLOW_MAX_C=42
THERMAL_ORANGE_MAX_C=45
THERMAL_EMERGENCY_C=50
THERMAL_COOLDOWN_SECONDS=600
THERMAL_RED_EVENTS_QUARANTINE=3
THERMAL_RED_WINDOW_SECONDS=3600
BATTERY_MIN_PCT_DISCHARGING=40
BATTERY_CRITICAL_PCT=15
BATTERY_HEAVY_MIN_PCT_DISCHARGING=60
# FARMSCORE_WEIGHTS / THERMAL_MODEL_OVERRIDES accept JSON; prefer the admin API at runtime.

# ── Phase 2: job leases, retries, verification, reputation ──
LEASE_ACCEPT_TIMEOUT_SECONDS=120
LEASE_DEFAULT_RUNTIME_SECONDS=300
LEASE_RUNTIME_BUFFER_SECONDS=60
LEASE_GRACE_SECONDS=30
LEASE_RENEW_SECONDS=120
LEASE_MAX_TOTAL_SECONDS=3600
LEASE_SWEEP_ON_POLL=true
JOB_DEFAULT_MAX_RETRIES=3
VERIFY_ON_SUBMIT=true
REDUNDANT_SAMPLE_RATE=0.2
REDUNDANT_FALLBACK_SCHEMA=true
REPUTATION_PASS_DELTA=1
REPUTATION_FAIL_DELTA=-10
REPUTATION_TIMEOUT_DELTA=-3
REPUTATION_CANARY_FAIL_DELTA=-25
REPUTATION_QUARANTINE_BELOW=15
VERIFICATION_FAILURES_QUARANTINE=3
VERIFICATION_FAILURE_WINDOW_SECONDS=86400

# ── Phase 3: scheduler, opportunities, profitability ──
SCHEDULER_INTERVAL_SECONDS=5
SCHEDULER_BATCH_LIMIT=100
DEVICE_ONLINE_SECONDS=180
MAX_CONCURRENT_JOBS_PER_DEVICE=1
MAX_INFLIGHT_PER_PROVIDER=500
# WORKLOAD_INFLIGHT_CAPS={"compression": 50}
SCHEDULER_AGING_PER_MINUTE=1.0
SCHEDULER_AGING_MAX=200
JOB_AUTO_SCHEDULE_DEFAULT=true
POWER_PRICE_KWH_USD=0.15
DEVICE_IDLE_WATTS=1.5
DEVICE_ACTIVE_WATTS=4.0
NETWORK_COST_PER_GB_USD=0.01
INFRA_COST_PER_JOB_USD=0.00001
INFRA_COST_PER_HOUR_USD=0.001
PAYOUT_FEE_PCT=0.01
DEFAULT_DEVICE_PURCHASE_USD=40
DEFAULT_DEVICE_RESALE_USD=8
DEVICE_EXPECTED_LIFETIME_HOURS=8760
BASE_FAILURE_PROBABILITY=0.02
# Price snapshot used to value token rewards (simulated adapter only in Phase 3)
# PRICE_SNAPSHOT_USD={"USD": 1.0, "USDC": 1.0, "ACU": 0.02}
# ASSET_VOLATILITY_HAIRCUT={"ACU": 0.35}
# ASSET_LIQUIDITY_HAIRCUT={"ACU": 0.20}
UNKNOWN_ASSET_HAIRCUT=0.5
