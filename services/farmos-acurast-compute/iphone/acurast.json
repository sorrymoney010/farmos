      "resourceLimits": {
        "maxMemory": 0,
        "maxNetworkRequests": 0,
        "maxStorage": 0
      },
      "costAndReputation": {
        "maxCostPerExecution": 0,
        "minProcessorReputation": 0
      },
      "processorWhitelist": [
        "5EgBZuiRnCfFzvBjgHitNymetm9daFoxEry8vn65sE4QErTj"
      ]
    }
  }
