#!/bin/sh

#
# Gradle start up script for POSIX (FARMOS node). Simplified, correct quoting:
# arguments are forwarded verbatim via "$@".
#

app_path=$0
PRG="$app_path"
while [ -h "$PRG" ]; do
    link=$(readlink "$PRG")
    case $link in
    *./*) PRG="$link" ;;
    *) PRG="$(dirname "$PRG")/$link" ;;
    esac
done

APP_HOME=$(cd "$(dirname "$PRG")" >/dev/null && pwd)

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

exec "$JAVACMD" \
    "-Dorg.gradle.appname=$(basename "$0")" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
